#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PI_BIN="$ROOT_DIR/pi-agent/node_modules/.bin/pi"
PI_AGENT_DIR="$ROOT_DIR/pi-agent/.pi/agent"

if [[ ! -x "$PI_BIN" ]]; then
  echo "Pi is not installed. Run: npm install --ignore-scripts --prefix \"$ROOT_DIR/pi-agent\"" >&2
  exit 1
fi

export PI_CODING_AGENT_DIR="$PI_AGENT_DIR"

exec "$PI_BIN" "$@"
